# removarr environment template. Copy to `.env` (never commit it). Values below are generic.
# Empty values count as "not set". Lists are comma-separated; mappings are service_path=app_path.
# Paths must not contain `,` or `=`.

# --- Required secrets (environment only) ---
# Argon2id PHC string. In a docker-compose.yml, double every `$` as `$$`.
REMOVARR_PASSWORD_HASH=
# At least 64 characters, for example the output of: openssl rand -hex 64
REMOVARR_SESSION_KEY=

# --- Required roots (no defaults; container paths) ---
REMOVARR_COMPLETED_ROOT=/data/completed
REMOVARR_MEDIA_ROOTS=/data/media
# REMOVARR_INCOMPLETE_ROOT=/data/incomplete

# --- Safety (leave as is until a dry run looks right) ---
REMOVARR_DRY_RUN=true
REMOVARR_AUTO_MODE=false

# --- File ownership expected on the roots (default: the process uid:gid) ---
# REMOVARR_EXPECTED_OWNER=1000:1000

# --- Path mappings: service view -> container view ---
# REMOVARR_QBIT_PATH_MAP=/downloads=/data/completed,/downloads/incomplete=/data/incomplete
# REMOVARR_SONARR_PATH_MAP=/tv=/data/media
# REMOVARR_RADARR_PATH_MAP=/movies=/data/media
# REMOVARR_JELLYFIN_PATH_MAP=/media=/data/media
# REMOVARR_QBIT_EXTERNAL_PREFIXES=

# --- Services (URL, then its secret) ---
# REMOVARR_QBIT_URL=http://qbittorrent:8080
# REMOVARR_QBIT_USERNAME=admin
# REMOVARR_QBIT_PASSWORD=
# REMOVARR_SONARR_URL=http://sonarr:8989
# REMOVARR_SONARR_API_KEY=
# REMOVARR_RADARR_URL=http://radarr:7878
# REMOVARR_RADARR_API_KEY=
# REMOVARR_JELLYFIN_URL=http://jellyfin:8096
# REMOVARR_JELLYFIN_API_KEY=

# --- Web ---
# REMOVARR_USERNAME=admin
# REMOVARR_COOKIE_SECURE=true
# Behind a reverse proxy set this to the proxy address/network (e.g. 172.18.0.0/16); otherwise all clients
# share one login rate-limit bucket (X-Forwarded-For is never trusted from an unknown peer).
# REMOVARR_TRUSTED_PROXIES=
# REMOVARR_LOG_LEVEL=info

# --- Capability flags (defaults shown) ---
# REMOVARR_CAP_CONSOLIDATE=true
# REMOVARR_CAP_DELETE_COMPLETED=true
# REMOVARR_CAP_CLEANUP_INCOMPLETE=true
# REMOVARR_CAP_FIX_PERMISSIONS=true
# REMOVARR_CAP_ARR_MANUAL_IMPORT=false
# REMOVARR_CAP_ARR_QUEUE_REMOVE=false
# REMOVARR_CAP_ARR_SET_MONITORED=false
# REMOVARR_CAP_ARR_GRAB=false
# REMOVARR_CAP_AUTO_REMOVE_EMPTY_TORRENTS=false
